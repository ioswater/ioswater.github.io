---
interface BlogPost {
  title: string;
  description: string;
  url: string;
  category: string;
  categoryLabel: string;
  date: string;
}

const { posts = [], locale = "zh-CN" } = Astro.props as {
  posts?: BlogPost[];
  locale?: string;
};
const isEn = locale === "en";

const labels = isEn
  ? {
      title: "Blog Hub",
      subtitle: "Browse all engineering notes by category, or jump to the latest posts.",
      search: "Search title or summary",
      category: "Category",
      startDate: "Start",
      endDate: "End",
      sort: "Sort",
      newest: "Newest first",
      oldest: "Oldest first",
      clear: "Clear",
      hierarchy: "Directory Layers",
      latest: "Latest Update",
      total: "Total Posts",
      empty: "No posts matched the current filter.",
      read: "Read",
      all: "All categories"
    }
  : {
      title: "技术博客",
      subtitle: "按左侧分类浏览全部技术笔记，或浏览最新发布。",
      search: "搜索标题或摘要",
      category: "分类",
      startDate: "开始日期",
      endDate: "结束日期",
      sort: "排序",
      newest: "最新优先",
      oldest: "最早优先",
      clear: "清空",
      hierarchy: "目录分层",
      latest: "最近更新",
      total: "文章总数",
      empty: "当前筛选条件下没有文章。",
      read: "阅读全文",
      all: "全部分类"
    };

const latestDate = posts.length ? posts.map((p) => p.date).sort().at(-1) : "-";
const categoryOrder = [...new Set(posts.map((p) => p.category))];
const categories = categoryOrder.map((key) => ({
  key,
  label: posts.find((p) => p.category === key)?.categoryLabel || key,
  count: posts.filter((p) => p.category === key).length
}));
---

<section class="blog-hub">
  <header class="hub-header">
    <div>
      <h1>{labels.title}</h1>
      <p>{labels.subtitle}</p>
    </div>
  </header>

  <div class="hub-layout">
    <aside class="hub-tree">
      <h2>{labels.hierarchy}</h2>
      <ul>
        <li>
          <button class="tree-filter is-all" data-category="" aria-pressed="true">
            <span>{labels.all}</span>
            <em>{posts.length}</em>
          </button>
        </li>
        {categories.map((c) => (
          <li>
            <button class="tree-filter" data-category={c.key}>
              <span>{c.label}</span>
              <em>{c.count}</em>
            </button>
          </li>
        ))}
      </ul>
    </aside>

    <div>
      <div id="blog-list" class="blog-list"></div>
    </div>
  </div>
</section>

<script is:inline id="blog-posts-data" type="application/json" set:html={JSON.stringify(posts)}></script>
<script is:inline id="blog-labels-data" type="application/json" set:html={JSON.stringify(labels)}></script>

<script>
  interface BlogPostClient {
    title: string;
    description: string;
    url: string;
    category: string;
    categoryLabel: string;
    date: string;
  }

  interface BlogLabels {
    empty: string;
    read: string;
  }

  const posts = JSON.parse(document.getElementById("blog-posts-data")?.textContent || "[]") as BlogPostClient[];
  const labels = JSON.parse(document.getElementById("blog-labels-data")?.textContent || "{}") as BlogLabels;

  const formatDate = (iso: string): string => {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || "");
    if (!m) return iso || "";
    return `${m[2]}·${m[3]}`;
  };

  const listEl = document.getElementById("blog-list") as HTMLDivElement | null;
  const treeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".tree-filter"));

  if (!listEl) {
    console.warn("BlogHub mount skipped: missing list container.");
  } else {
    let activeCategory = "";

    const allBtn = document.querySelector<HTMLButtonElement>(".tree-filter.is-all");
    const syncTreeState = (currentCategory: string) => {
      treeButtons.forEach((btn) => {
        const isActive = currentCategory !== "" && btn.dataset.category === currentCategory;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });
      if (allBtn) {
        allBtn.classList.toggle("active", currentCategory === "");
        allBtn.setAttribute("aria-pressed", String(currentCategory === ""));
      }
    };

    const render = () => {
      const filtered: BlogPostClient[] = posts
        .filter((p: BlogPostClient) => !activeCategory || p.category === activeCategory)
        .sort((a: BlogPostClient, b: BlogPostClient) => b.date.localeCompare(a.date));

      syncTreeState(activeCategory);

      if (!filtered.length) {
        listEl.innerHTML = `<div class=\"empty\">${labels.empty}</div>`;
        return;
      }

      listEl.innerHTML = filtered
        .map(
          (p: BlogPostClient, index: number) => `
          <article class=\"post-card\" style=\"--idx:${index};\">
            <span class=\"post-date\">${formatDate(p.date)}</span>
            <div class=\"post-body\">
              <h3><a href=\"${p.url}\">${p.title}</a></h3>
              <p>${p.description || ""}</p>
              <div class=\"post-meta\">
                <span class=\"post-chip\">${p.categoryLabel}</span>
                <a class=\"post-read\" href=\"${p.url}\">${labels.read} →</a>
              </div>
            </div>
          </article>
        `
        )
        .join("");
    };

    treeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.dataset.category || "";
        render();
      });
    });

    render();
  }
</script>

<style>
  .blog-hub {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0.2rem 0 1.6rem;
  }

  .hub-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    animation: hub-rise 0.48s ease-out both;
  }

  .hub-header h1 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    letter-spacing: -0.03em;
  }

  .hub-header p {
    margin: 0.6rem 0 0;
    max-width: 60ch;
    color: var(--sl-color-gray-3);
  }

  .hub-layout {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 1rem;
  }

  .hub-tree {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    padding: 0.9rem;
    height: fit-content;
    position: sticky;
    top: 6.2rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 16%, transparent);
  }

  .hub-tree h2 {
    margin: 0;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
  }

  .hub-tree ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .tree-filter {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    border: 1px solid var(--sl-color-hairline);
    background: transparent;
    color: var(--sl-color-white);
    border-radius: 10px;
    padding: 0.55rem 0.65rem;
    cursor: pointer;
    transition: border-color 0.22s ease, color 0.22s ease, background-color 0.22s ease, transform 0.22s ease;
  }

  .tree-filter:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 52%, transparent);
    color: var(--sl-color-accent);
    transform: translateY(-1px);
  }

  .tree-filter.active {
    border-color: color-mix(in srgb, var(--sl-color-accent) 52%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
    color: var(--sl-color-accent-high);
  }

  .tree-filter em {
    font-style: normal;
    opacity: 0.72;
  }

  .blog-list {
    display: block;
  }

  /* 信息流卡片样式（分割线 + hover + card-rise 入场）已迁至 global.css：
     卡片由 JS 经 innerHTML 注入、不带 Astro 的 data-astro-cid，作用域样式无法命中，故须全局。 */
  @keyframes hub-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 980px) {
    .hub-layout {
      grid-template-columns: 1fr;
    }

    .hub-tree {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-header {
      animation: none;
    }

    .tree-filter {
      transition: none;
    }
  }
</style>
