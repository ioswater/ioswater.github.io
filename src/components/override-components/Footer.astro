---
import config from "@/config/config.json" assert { type: "json" };
import { markdownify } from "@/lib/utils/textConverter";
import { getTranslations } from "@/lib/utils/languagePerser";

const locale = Astro.currentLocale || "root";
const menu = await getTranslations(locale);
const footer = menu.footer || {};

// 扁平化配置里的真实链接，凑成设计稿的极简链接行（不 404）
const footerLinks = [
  ...(footer.community?.links || []),
  ...(footer.help_links?.links || []),
  ...(footer.company?.links || []),
];
---

<footer class="site-footer">
  <div class="wrap foot-grid">
    <p class="copyright" set:html={markdownify(config?.params?.copyright)} />
    <nav class="foot-links" aria-label="页脚导航">
      {footerLinks.map((link: any) => <a href={link.url}>{link.name}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    /* 品牌渐变顶线：让品牌色成为整站贯穿线，而不只是卡片镶边 */
    border-top: 2px solid transparent;
    border-image: var(--color-primary-gradient) 1;
    padding: 3rem 0;
    background: color-mix(in srgb, var(--sl-color-black) 82%, transparent);
  }
  .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
  .foot-grid {
    display: flex; justify-content: space-between; gap: 1.25rem;
    flex-wrap: wrap; align-items: center;
  }
  .copyright {
    margin: 0; font-size: 0.875rem; color: var(--sl-color-gray-3);
    font-family: "Instrument Sans", system-ui, sans-serif;
  }
  .foot-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .foot-links a {
    font-size: 0.875rem; color: var(--sl-color-gray-3);
    text-decoration: none; transition: color 120ms ease;
  }
  .foot-links a:hover { color: var(--sl-color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .foot-links a { transition: none; }
  }
</style>
