---
import Breadcrumb from "../Breadcrumb.astro";
---

<div class="content-container">
  <div class="reading-progress" aria-hidden="true"><span class="reading-progress-fill"></span></div>
  <div class="kbd-hint" id="kbd-hint" role="status">
    <kbd>f</kbd><span class="kbd-sep">·</span>专注
    <span class="kbd-sep">·</span><kbd>j</kbd>/<kbd>k</kbd> 章节
    <span class="kbd-sep">·</span><kbd>[</kbd>/<kbd>]</kbd> 翻页
    <span class="kbd-sep">·</span><kbd>?</kbd> 帮助
  </div>
  <div class="main-pane">
    {
      Astro.locals.starlightRoute.hasSidebar && (
        <div class="breadcrumb-container">
          <Breadcrumb />
        </div>
      )
    }

    <slot />
  </div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <button
          class="toc-toggle"
          id="toc-toggle"
          type="button"
          aria-expanded="true"
          aria-controls="toc-body"
          title="展开 / 收起目录"
        >
          <svg
            class="toc-caret"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 6 15 12 9 18" />
          </svg>
        </button>
        <div class="right-sidebar">
          <div class="toc-panel" id="toc-panel">
            <div class="toc-body" id="toc-body">
              <slot name="right-sidebar" />
            </div>
          </div>
        </div>
      </aside>
    )
  }
</div>

<script is:inline>
  (function () {
    // 右侧目录：点击与滑动共用 Starlight 原生 scrollspy 的 aria-current="true" 机制，保证两者一致
    function bindToc() {
      // 仅针对桌面端目录（<starlight-toc>），排除移动端 <mobile-starlight-toc> 的重复链接，
      // 否则点击/滑动会出现两个高亮
      var links = Array.prototype.slice.call(
        document.querySelectorAll(".right-sidebar-container starlight-toc a[href^='#']")
      );
      if (!links.length) return;

      var sidebar = document.querySelector(".right-sidebar");
      // 程序化滚动抑制态：点击后正文平滑滚动途中，scrollspy 会依次命中中间小节，
      // 此时目录“追尾”式滚动正是抖动的元凶；标记期内只认被点击的那一项。
      var programmatic = false;
      var clickedLink = null;
      var programmaticTimer = null;

      // 仅当高亮项超出目录可视范围（含缓冲边距）时才滚动居中；已在范围内则不动，
      // 避免页面滚动时目录面板持续漂移产生卡顿。
      var scrollActiveIntoView = function (link, immediate) {
        if (!sidebar || !link) return;
        var sbRect = sidebar.getBoundingClientRect();
        var linkRect = link.getBoundingClientRect();
        var topWithin = linkRect.top - sbRect.top;
        var bottomWithin = topWithin + linkRect.height;
        var edge = 14;
        var visible = topWithin >= edge && bottomWithin <= sbRect.height - edge;
        if (visible && !immediate) return;
        var offsetWithin = topWithin + sidebar.scrollTop;
        var target = offsetWithin - sbRect.height / 2 + linkRect.height / 2;
        target = Math.max(0, Math.min(target, sidebar.scrollHeight - sbRect.height));
        sidebar.scrollTo({ top: target, behavior: immediate ? "auto" : "smooth" });
      };

      // Starlight 原生 scrollspy 写入 aria-current="true" 即为唯一高亮来源（点击与滑动共用）。
      // 监听该属性变化，让目录面板自动滚动，使高亮项始终处于可视范围。
      var mo = new MutationObserver(function (mutations) {
        mutations.forEach(function (m) {
          if (m.attributeName !== "aria-current") return;
          if (m.target.getAttribute("aria-current") !== "true") return;
          if (programmatic && m.target !== clickedLink) return; // 点击途中中间态：跳过，杜绝抖动
          if (programmatic && m.target === clickedLink) {
            scrollActiveIntoView(m.target); // 目标项最终命中：平滑居中一次，解除抑制
            programmatic = false;
            clickedLink = null;
            if (programmaticTimer) { clearTimeout(programmaticTimer); programmaticTimer = null; }
            return;
          }
          scrollActiveIntoView(m.target);
        });
      });

      links.forEach(function (link) {
        if (link.__tocBound) return;
        link.__tocBound = true;
        mo.observe(link, { attributes: true, attributeFilter: ["aria-current"] });
        link.addEventListener("click", function (e) {
          // 不手动写 aria-current：交由 Starlight scrollspy 统一高亮，杜绝双高亮。
          // 滚动时把目标标题定位到 Starlight 的激活带（nav 高度 + ~56px）内，
          // 使 scrollspy 命中“被点击的”这一项，且正文平滑滑动到对应位置。
          var id = (link.getAttribute("href") || "").slice(1);
          var target = id && document.getElementById(id);
          if (target) {
            e.preventDefault();
            var header = document.querySelector("header");
            var headerH = header ? header.getBoundingClientRect().height : 56;
            var rect = target.getBoundingClientRect();
            var y = rect.top + window.scrollY - (headerH + 56);
            programmatic = true;
            clickedLink = link;
            if (programmaticTimer) clearTimeout(programmaticTimer);
            programmaticTimer = setTimeout(function () {
              programmatic = false;
              clickedLink = null;
              programmaticTimer = null;
            }, 900);
            window.scrollTo({ top: Math.max(0, y), behavior: "smooth" });
            try { history.replaceState(null, "", "#" + id); } catch (err) {}
          }
          // 不再立即 scrollActiveIntoView：交 scrollspy 在目标项激活后统一居中一次
        });
      });
    }

    // 表格：悬停整列高亮（事件委托，按 cellIndex 给同列单元格加 .col-hover）
    function bindTableColHover() {
      var tables = Array.prototype.slice.call(
        document.querySelectorAll(".sl-markdown-content table")
      );
      tables.forEach(function (table) {
        if (table.__colHoverBound) return;
        table.__colHoverBound = true;
        table.addEventListener("mouseover", function (e) {
          var cell = e.target.closest("td, th");
          if (!cell) return;
          var idx = Array.prototype.indexOf.call(cell.parentNode.children, cell);
          table.querySelectorAll("tr").forEach(function (tr) {
            var c = tr.children[idx];
            if (c) c.classList.add("col-hover");
          });
        });
        table.addEventListener("mouseout", function () {
          table.querySelectorAll(".col-hover").forEach(function (c) {
            c.classList.remove("col-hover");
          });
        });
      });
    }

    document.addEventListener("astro:page-load", function () {
      bindToc();
      bindTableColHover();
    });
    bindToc();
    bindTableColHover();
  })();
</script>

<style>
  @layer starlight.core {
    .content-container {
      width: 100%;
      overflow: hidden;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }

    .main-pane {
      /* isolation: isolate; */
      width: 100%;
    }
    :global([data-has-sidebar][data-has-toc]) .main-pane {
      overflow: hidden;
    }

    @media (min-width: 72rem) {
      :global([data-has-sidebar][data-has-toc]) .content-container {
        --toc-track: var(--sl-table-of-contents-width, 16rem);
        display: grid;
        grid-template-columns: minmax(0, 1fr) var(--toc-track);
        overflow: visible;
        transition:
          opacity 0.3s ease-in-out,
          grid-template-columns 0.38s cubic-bezier(0.4, 0, 0.2, 1);
      }
      /* 抽屉收起：右侧列宽收到 0，正文占满让出的空间 */
      :global([data-has-sidebar][data-has-toc]) .content-container.toc-collapsed {
        --toc-track: 0px;
      }
      .breadcrumb-container {
        max-width: var(--sl-content-width);
        /* 居左固定：抽屉开合时标题区左边缘不动；左内边距与正文 .content-panel 对齐 */
        margin-inline: 0;
        padding-inline: var(--sl-content-pad-x);
      }
      .right-sidebar-container {
        order: 2;
        position: relative;
        width: 100%;
        min-width: 0;
      }

      .right-sidebar {
        position: sticky;
        inset-block: calc(var(--sl-nav-height) + 2rem) 0;
        width: 100%;
        height: calc(100dvh - var(--sl-nav-height) - 4rem);
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: none;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        /* 正文内容列左对齐（align-start），左边缘在抽屉开合时保持固定；
           focus 模式已由 global.css 的 !important 规则恢复居中。 */
        --sl-content-margin-inline: 0;

        order: 1;
        overflow: hidden;
        border-left: 1px solid var(--sl-color-hairline);
        border-right: 1px solid var(--sl-color-hairline);
      }
    }
  }
</style>

<script>
  const contentContainer = document.querySelector(
    ".content-container"
  ) as HTMLElement;

  if (contentContainer) {
    contentContainer.style.opacity = "1";
  }
</script>

<script is:inline>
  (function () {
    var bar = null, hint = null, hintTimer = null, ticking = false;
    function updateProgress() {
      var docEl = document.documentElement;
      var scrollTop = window.scrollY || docEl.scrollTop || 0;
      var height = docEl.scrollHeight - window.innerHeight;
      var pct = height > 0 ? Math.min(100, Math.max(0, (scrollTop / height) * 100)) : 0;
      if (bar) bar.style.width = pct + "%";
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () { updateProgress(); ticking = false; });
      }
    }
    function goHeading(dir) {
      var headings = Array.prototype.slice
        .call(document.querySelectorAll("main h2, main h3, main h4"))
        .filter(function (h) { return h.id; });
      if (!headings.length) return;
      var y = window.scrollY + 80;
      if (dir > 0) {
        var next = headings.find(function (h) {
          return h.getBoundingClientRect().top + window.scrollY > y + 1;
        });
        (next || headings[headings.length - 1]).scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        var prevs = headings.filter(function (h) {
          return h.getBoundingClientRect().top + window.scrollY < y - 1;
        });
        (prevs.length ? prevs[prevs.length - 1] : headings[0]).scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }
    function goArticle(sel) {
      var a = document.querySelector(sel);
      var href = a && a.getAttribute("href");
      if (href) location.href = href;
    }
    function showHint() {
      if (!hint) return;
      hint.classList.remove("dismissed");
      clearTimeout(hintTimer);
      hintTimer = setTimeout(function () { if (hint) hint.classList.add("dismissed"); }, 6000);
    }
    function hideHint() { if (hint) hint.classList.add("dismissed"); }
    function init() {
      bar = document.querySelector(".reading-progress-fill");
      hint = document.getElementById("kbd-hint");
      updateProgress();
      if (hint) {
        hint.addEventListener("click", hideHint);
        clearTimeout(hintTimer);
        hintTimer = setTimeout(function () { if (hint) hint.classList.add("dismissed"); }, 6000);
      }
    }
    if (!window.__readingKeyBound) {
      window.__readingKeyBound = true;
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      document.addEventListener("keydown", function (e) {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        var t = e.target;
        if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable)) return;
        switch (e.key) {
          case "j": e.preventDefault(); goHeading(1); break;
          case "k": e.preventDefault(); goHeading(-1); break;
          case "[": e.preventDefault(); goArticle('a[rel="prev"]'); break;
          case "]": e.preventDefault(); goArticle('a[rel="next"]'); break;
          case "?": e.preventDefault(); (hint && hint.classList.contains("dismissed")) ? showHint() : hideHint(); break;
        }
      });
    }
    document.addEventListener("astro:page-load", init);
    init();
  })();
</script>

<script is:inline>
  (function () {
    // 目录抽屉：恢复上次状态，避免首屏闪烁
    try {
      var cc = document.querySelector(".content-container");
      if (cc && localStorage.getItem("toc-collapsed") === "true") {
        cc.classList.add("toc-collapsed");
      }
    } catch (e) {}

    function initToc() {
      var cc = document.querySelector(".content-container");
      var btn = document.getElementById("toc-toggle");
      if (!cc || !btn || btn.__tocBound) return;
      btn.__tocBound = true;
      btn.setAttribute("aria-expanded", String(!cc.classList.contains("toc-collapsed")));
      btn.addEventListener("click", function () {
        var collapsed = cc.classList.toggle("toc-collapsed");
        btn.setAttribute("aria-expanded", String(!collapsed));
        try {
          localStorage.setItem("toc-collapsed", collapsed ? "true" : "false");
        } catch (e) {}
      });
    }

    document.addEventListener("astro:page-load", initToc);
    initToc();
  })();
</script>